	pages = {1387--1393},
	file = {Full Text PDF:/home/hossam26644/Zotero/storage/5RUSGBJQ/McVean and Cardin - 2005 - Approximating the coalescent with recombination.pdf:application/pdf;Snapshot:/home/hossam26644/Zotero/storage/VHCETRXU/rstb.2005.html:text/html},
}

